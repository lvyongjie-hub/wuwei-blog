# Public site URL used by Astro sitemap and canonical metadata.
SITE_URL=https://wuwei-blog.pages.dev

# Public contact links. Keep the email empty until a dedicated address is ready.
PUBLIC_GITHUB_URL=https://github.com/lvyongjie-hub
PUBLIC_CONTACT_EMAIL=

# Optional Cloudflare Web Analytics token. Leave empty to disable the beacon.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Optional Giscus configuration. The comments UI stays a placeholder until all IDs exist.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY_ID=
