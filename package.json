{
  "name": "wuwei-blog",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "五味书房：一个关于嵌入式系统、边缘 AI、项目档案与随笔的开源数字书房。",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "npm run check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "preview": "npm run build && wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "links:check": "node scripts/check-links.mjs",
    "a11y:check": "html-validate \"dist/**/*.html\"",
    "verify": "npm run format:check && npm run build && npm run links:check && npm run a11y:check",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@sveltia/cms": "^0.173.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "pagefind": "^1.5.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/three": "^0.185.1",
    "cross-env": "^10.1.0",
    "html-validate": "^11.5.6",
    "linkinator": "^8.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
